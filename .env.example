# Copy this file to .env.local and fill in the values. Never commit .env.local.

# PostgreSQL connection, used by the app and by Prisma migrations
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trip_weave

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=your_super_secret_key_here

# Flight search (Duffel). A test-mode token starts with duffel_test_
DUFFEL_API_URL="https://api.duffel.com"
DUFFEL_TOKEN=your_duffel_secret_key_here
# Optional: return sample flights when a Duffel request fails
# DUFFEL_USE_MOCK=true

# Turning chat messages into flight searches (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
