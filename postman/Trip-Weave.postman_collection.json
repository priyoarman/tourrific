        {
          "name": "Save a flight",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/saved-flights/save",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "saved-flights",
                "save"
              ]
            },
            "description": "Saves a flight and stores its id in `saved_flight_id`. 409 if this flight and departure time is already saved.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flight_number\": \"BA811\",\n  \"origin\": \"CPH\",\n  \"destination\": \"LHR\",\n  \"price\": 96.85,\n  \"departure_time\": \"2026-11-12T08:30:00Z\",\n  \"currency_code\": \"EUR\",\n  \"airline_code\": \"BA\",\n  \"airline_name\": \"British Airways\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.flight) pm.collectionVariables.set(\"saved_flight_id\", body.flight.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove a saved flight",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/saved-flights/save/{{saved_flight_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "saved-flights",
                "save",
                "{{saved_flight_id}}"
              ]
            },
            "description": "Removes one of your own saved flights. 404 for an id that isn't yours.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
    },
