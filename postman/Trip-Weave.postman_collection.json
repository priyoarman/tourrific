    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "description": "Creates an account. It does not sign in: log in next. 409 if the email is taken.\n\n429 (with a Retry-After header) after 5 sign-up attempts from one IP address in a day.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Traveller\",\n  \"email\": \"traveller@example.com\",\n  \"password\": \"testpass123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [
            {
              "name": "429 Too many sign-ups",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/auth/signup",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "auth",
                    "signup"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Test Traveller\",\n  \"email\": \"traveller@example.com\",\n  \"password\": \"testpass123\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "Too Many Requests",
              "code": 429,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "Retry-After",
                  "value": "86400"
                }
              ],
              "cookie": [],
              "body": "{\n  \"success\": false,\n  \"message\": \"Too many sign-ups from this network today. Please try again tomorrow.\",\n  \"retryAfterSeconds\": 86400\n}"
            }
          ]
        },
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Signs in: the answer sets a `session` cookie that lasts 1 hour, which is kept in the cookie jar and sent with the other requests. The token is in that cookie only, not in the body.\n\n429 (with a Retry-After header) after 10 login attempts from one IP address in 15 minutes, right or wrong.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"traveller@example.com\",\n  \"password\": \"testpass123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [
            {
              "name": "429 Too many login attempts",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/auth/login",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "auth",
                    "login"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"traveller@example.com\",\n  \"password\": \"testpass123\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "Too Many Requests",
              "code": 429,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "Retry-After",
                  "value": "900"
                }
              ],
              "cookie": [],
              "body": "{\n  \"success\": false,\n  \"message\": \"Too many login attempts. Please try again in 15 minutes.\",\n  \"retryAfterSeconds\": 900\n}"
            }
          ]
        },
        {
          "name": "Verify login",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "verify"
              ]
            },
            "description": "200 with the signed-in user while the session cookie is valid, 401 once it has expired or after logging out.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Log out",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Removes the session cookie. The requests that need a login answer 401 until you log in again.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Flight search",
      "item": [
        {
          "name": "Search (streaming)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/flights/search-stream",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "flights",
                "search-stream"
              ]
            },
            "description": "The endpoint the app uses. Answers with server-sent events: status, message, complete (the flights), hotels (the places to stay that go with them), done. Add \"context\": { \"destination\", \"tripQuery\" } from a previous `complete` event to send a follow-up such as \"a little later\".\n\nHotels: the `hotels` event follows `complete` when the trip has at least one night; a one-way trip is given 3. Hotel wishes go in the prompt, for example \"... and a 4-star hotel with a pool under 150 euros a night\". `failed: true` means the hotel search didn't answer, which is also what happens until Duffel has switched Stays on for the account. `sample: true` means made-up hotels, sent instead when DUFFEL_USE_MOCK=true.\n\nNo login needed. A guest gets 10 searches a day per IP address; after **Log in** the search counts against the account instead, which gets 50. Everyone is limited to 5 a minute.\n\n400 (JSON) when the body is over 8 KB, the prompt is empty or longer than 500 characters, or the context isn't a valid previous search.\n\n429 (JSON, with a Retry-After header) when a limit is reached. `reason` is one of: `burst` (5 a minute), `guest_limit` (10 a day, not logged in), `user_limit` (50 a day, logged in), `busy` (500 a day across all visitors).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Direct flights from Copenhagen to London next Friday with a checked bag\",\n  \"limit\": \"all\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [
            {
              "name": "429 Guest limit reached",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/flights/search-stream",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "flights",
                    "search-stream"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"prompt\": \"Direct flights from Copenhagen to London next Friday with a checked bag\",\n  \"limit\": \"all\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "Too Many Requests",
              "code": 429,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "Retry-After",
                  "value": "85200"
                }
              ],
              "cookie": [],
              "body": "{\n  \"success\": false,\n  \"reason\": \"guest_limit\",\n  \"message\": \"You've used your free searches for today. Sign in or sign up to keep going.\",\n  \"retryAfterSeconds\": 85200\n}"
            },
            {
              "name": "429 Searching too quickly",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/flights/search-stream",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "flights",
                    "search-stream"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"prompt\": \"Direct flights from Copenhagen to London next Friday with a checked bag\",\n  \"limit\": \"all\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "Too Many Requests",
              "code": 429,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "Retry-After",
                  "value": "42"
                }
              ],
              "cookie": [],
              "body": "{\n  \"success\": false,\n  \"reason\": \"burst\",\n  \"message\": \"You're searching very quickly. Please wait a moment and try again.\",\n  \"retryAfterSeconds\": 42\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Saved flights",
